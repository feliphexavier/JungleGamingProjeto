{
  "info": {
    "name": "Jungle Wallet (local)",
    "description": "Testes manuais da API de carteiras contra o ambiente do Docker Compose.\n\nPré-requisito: `docker compose up --build -d --wait` (ver README).\n\nOrdem sugerida: execute as pastas de cima para baixo (ou use o Collection Runner). Os tokens, o id da carteira e os ids das operações são salvos automaticamente em variáveis da collection.\n\nPortas: API 8080, Keycloak 8081, LocalStack (SQS) 4566.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    { "listen": "prerequest", "script": { "exec": [
      "// Impede enviar requisições com variáveis ainda vazias (URL incompleta vira 404, token vazio vira 401).",
      "const needs = {",
      "  tokenInternal: 'Execute a pasta \"1. Tokens\" primeiro.',",
      "  tokenProviderA: 'Execute a pasta \"1. Tokens\" primeiro.',",
      "  tokenProviderB: 'Execute a pasta \"1. Tokens\" primeiro.',",
      "  tokenUntrusted: 'Execute a pasta \"1. Tokens\" primeiro.',",
      "  walletId: 'Execute \"2. Carteira > Abrir carteira com 100.00\" primeiro.',",
      "  transactionId: 'Execute \"3. Operações do provedor > BET 25.00\" primeiro.',",
      "  betId: 'Execute \"3. Operações do provedor > BET 25.00\" primeiro.'",
      "};",
      "const raw = JSON.stringify(pm.request.toJSON());",
      "for (const [name, hint] of Object.entries(needs)) {",
      "  if (name === 'betId' && pm.info.requestName === 'BET 25.00') continue; // essa requisição gera o betId",
      "  if (raw.includes('{{' + name + '}}') && !pm.collectionVariables.get(name)) {",
      "    throw new Error('Variável ' + name + ' vazia. ' + hint);",
      "  }",
      "}"
    ] } }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "kcUrl", "value": "http://127.0.0.1:8081/realms/wallet/protocol/openid-connect/token" },
    { "key": "sqsUrl", "value": "http://localhost:4566" },
    { "key": "queuePrefix", "value": "http://localhost:4566/000000000000" },
    { "key": "tokenInternal", "value": "" },
    { "key": "tokenProviderA", "value": "" },
    { "key": "tokenProviderB", "value": "" },
    { "key": "tokenUntrusted", "value": "" },
    { "key": "playerId", "value": "" },
    { "key": "walletId", "value": "" },
    { "key": "betId", "value": "" },
    { "key": "transactionId", "value": "" },
    { "key": "sqsRequest", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Readiness",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 e status UP', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().status).to.eql('UP');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" }
        }
      ]
    },
    {
      "name": "1. Tokens (Keycloak)",
      "description": "client_credentials. Tokens valem 5 minutos: execute esta pasta de novo se receber 401 por expiração.",
      "item": [
        {
          "name": "Token serviço interno",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('token emitido', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('tokenInternal', pm.response.json().access_token);"
          ] } }],
          "request": {
            "method": "POST",
            "url": "{{kcUrl}}",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "client_id", "value": "wallet-internal" },
              { "key": "client_secret", "value": "wallet-internal-secret" }
            ] }
          }
        },
        {
          "name": "Token provider-a",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('token emitido', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('tokenProviderA', pm.response.json().access_token);"
          ] } }],
          "request": {
            "method": "POST",
            "url": "{{kcUrl}}",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "client_id", "value": "provider-a" },
              { "key": "client_secret", "value": "provider-a-secret" }
            ] }
          }
        },
        {
          "name": "Token provider-b",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('token emitido', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('tokenProviderB', pm.response.json().access_token);"
          ] } }],
          "request": {
            "method": "POST",
            "url": "{{kcUrl}}",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "client_id", "value": "provider-b" },
              { "key": "client_secret", "value": "provider-b-secret" }
            ] }
          }
        },
        {
          "name": "Token client sem permissões",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('token emitido', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('tokenUntrusted', pm.response.json().access_token);"
          ] } }],
          "request": {
            "method": "POST",
            "url": "{{kcUrl}}",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "client_id", "value": "untrusted-client" },
              { "key": "client_secret", "value": "untrusted-client-secret" }
            ] }
          }
        },
        {
          "name": "Segredo errado (401 no Keycloak)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Keycloak recusa', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "POST",
            "url": "{{kcUrl}}",
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "client_credentials" },
              { "key": "client_id", "value": "provider-a" },
              { "key": "client_secret", "value": "errado" }
            ] }
          }
        }
      ]
    },
    {
      "name": "2. Carteira (serviço interno)",
      "item": [
        {
          "name": "Abrir carteira com 100.00",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('playerId', pm.variables.replaceIn('{{$guid}}'));"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201 com saldo 100.00', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().balance.amount).to.eql('100.00');",
              "});",
              "pm.collectionVariables.set('walletId', pm.response.json().id);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallets",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenInternal}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": { \"amount\": \"100.00\", \"currency\": \"BRL\" }\n}" }
          }
        },
        {
          "name": "Consultar carteira",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallets/{{walletId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenInternal}}" }] }
          }
        },
        {
          "name": "Ledger",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallets/{{walletId}}/ledger?limit=50",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenInternal}}" }] }
          }
        },
        {
          "name": "Reconciliação",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('saldo consistente com o ledger', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().consistent).to.eql(true);",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallets/{{walletId}}/reconciliation",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenInternal}}" }] }
          }
        }
      ]
    },
    {
      "name": "3. Operações do provedor (HTTP)",
      "item": [
        {
          "name": "BET 25.00",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('betId', 'bet-' + Date.now());"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201 processada, saldo 75.00', () => {",
              "  pm.response.to.have.status(201);",
              "  const b = pm.response.json();",
              "  pm.expect(b.status).to.eql('PROCESSED');",
              "  pm.expect(b.balance.amount).to.eql('75.00');",
              "  pm.expect(b.idempotentReplay).to.eql(false);",
              "});",
              "pm.collectionVariables.set('transactionId', pm.response.json().transactionId);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wagering/transactions",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProviderA}}" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "provider-a:{{betId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{betId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" }\n}" }
          }
        },
        {
          "name": "BET 25.00 de novo (replay)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 replay com o saldo original, sem novo débito', () => {",
            "  pm.response.to.have.status(200);",
            "  const b = pm.response.json();",
            "  pm.expect(b.idempotentReplay).to.eql(true);",
            "  pm.expect(b.balance.amount).to.eql('75.00');",
            "  pm.expect(b.transactionId).to.eql(pm.collectionVariables.get('transactionId'));",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wagering/transactions",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProviderA}}" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "provider-a:{{betId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{betId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" }\n}" }
          }
        },
        {
          "name": "Mesma chave, outro valor (409)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 IDEMPOTENCY_CONFLICT', () => {",
            "  pm.response.to.have.status(409);",
            "  pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_CONFLICT');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wagering/transactions",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProviderA}}" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "provider-a:{{betId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{betId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"99.00\", \"currency\": \"BRL\" }\n}" }
          }
        },
        {
          "name": "WIN 10.00",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('winId', 'win-' + Date.now());"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201, saldo 85.00', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().balance.amount).to.eql('85.00');",
              "});"
            ] } }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wagering/transactions",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProviderA}}" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "provider-a:{{winId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{winId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"WIN\",\n  \"money\": { \"amount\": \"10.00\", \"currency\": \"BRL\" }\n}" }
          }
        },
        {
          "name": "REFUND da BET",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('refundId', 'refund-' + Date.now());"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201, devolve os 25.00 (saldo 110.00)', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.json().balance.amount).to.eql('110.00');",
              "});"
            ] } }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wagering/transactions",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProviderA}}" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "provider-a:{{refundId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{refundId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"REFUND\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" },\n  \"referenceExternalTransactionId\": \"{{betId}}\"\n}" }
          }
        },
        {
          "name": "BET acima do saldo (422 REJECTED)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('bigBetId', 'bet-big-' + Date.now());"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('422 REJECTED por saldo insuficiente', () => {",
              "  pm.response.to.have.status(422);",
              "  pm.expect(pm.response.json().status).to.eql('REJECTED');",
              "});"
            ] } }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wagering/transactions",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProviderA}}" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "provider-a:{{bigBetId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{bigBetId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"5000.00\", \"currency\": \"BRL\" }\n}" }
          }
        },
        {
          "name": "Consultar transação por id",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wagering/transactions/{{transactionId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProviderA}}" }] }
          }
        },
        {
          "name": "Consultar por id externo",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/providers/provider-a/wagering/transactions/{{betId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProviderA}}" }] }
          }
        }
      ]
    },
    {
      "name": "4. Segurança",
      "item": [
        {
          "name": "Sem token (401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/wallets/{{walletId}}" }
        },
        {
          "name": "Token adulterado (401)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));"
          ] } }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallets/{{walletId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenInternal}}x" }]
          }
        },
        {
          "name": "Provedor abrindo carteira (403)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));"
          ] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallets",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProviderA}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"playerId\": \"{{$guid}}\",\n  \"initialBalance\": { \"amount\": \"1000000.00\", \"currency\": \"BRL\" }\n}" }
          }
        },
        {
          "name": "provider-b enviando em nome de provider-a (403)",
