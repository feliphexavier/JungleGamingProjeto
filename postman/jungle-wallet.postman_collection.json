          ] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wagering/transactions",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenProviderA}}" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "provider-a:float-{{$timestamp}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"float-{{$timestamp}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": 25.00, \"currency\": \"BRL\" }\n}" }
          }
        }
      ]
    },
    {
      "name": "5. SQS (LocalStack)",
      "description": "Chamadas diretas à API JSON do SQS no LocalStack. O token do provedor vai no atributo de mensagem Authorization. Depois de enviar, aguarde 1 a 2 segundos e consulte a carteira ou as filas.",
      "item": [
        {
          "name": "Enviar BET 10.00 pelo SQS",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const id = 'sqs-bet-' + Date.now();",
              "pm.collectionVariables.set('sqsBetId', id);",
              "const envelope = {",
              "  messageId: 'msg-' + id,",
              "  type: 'WagerOperationRequested',",
              "  occurredAt: new Date().toISOString(),",
              "  data: {",
              "    idempotencyKey: 'provider-a:' + id,",
              "    providerId: 'provider-a',",
              "    externalTransactionId: id,",
              "    playerId: pm.collectionVariables.get('playerId'),",
              "    walletId: pm.collectionVariables.get('walletId'),",
              "    roundId: 'round-987',",
              "    gameId: 'fortune-chimp',",
              "    kind: 'BET',",
              "    money: { amount: '10.00', currency: 'BRL' }",
              "  }",
              "};",
              "pm.collectionVariables.set('sqsEnvelope', JSON.stringify(envelope));",
              "pm.collectionVariables.set('sqsRequest', JSON.stringify({",
              "  QueueUrl: pm.collectionVariables.get('queuePrefix') + '/wager-operations.fifo',",
              "  MessageBody: JSON.stringify(envelope),",
              "  MessageGroupId: pm.collectionVariables.get('walletId'),",
              "  MessageDeduplicationId: id,",
              "  MessageAttributes: {",
              "    Authorization: { DataType: 'String', StringValue: 'Bearer ' + pm.collectionVariables.get('tokenProviderA') }",
              "  }",
              "}));"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('mensagem aceita pelo SQS', () => pm.response.to.have.status(200));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "url": "{{sqsUrl}}/",
            "header": [
              { "key": "Content-Type", "value": "application/x-amz-json-1.0" },
              { "key": "X-Amz-Target", "value": "AmazonSQS.SendMessage" }
            ],
            "body": { "mode": "raw", "raw": "{{sqsRequest}}" }
          }
        },
        {
          "name": "Reenviar a mesma mensagem (sem novo débito)",
          "description": "Mesmo messageId no envelope, outro MessageDeduplicationId no SQS: a mensagem é entregue de novo e a inbox no PostgreSQL impede o segundo débito.",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const envelope = pm.collectionVariables.get('sqsEnvelope');",
              "pm.collectionVariables.set('sqsRequest', JSON.stringify({",
              "  QueueUrl: pm.collectionVariables.get('queuePrefix') + '/wager-operations.fifo',",
              "  MessageBody: envelope,",
              "  MessageGroupId: pm.collectionVariables.get('walletId'),",
              "  MessageDeduplicationId: 'redelivery-' + Date.now(),",
              "  MessageAttributes: {",
              "    Authorization: { DataType: 'String', StringValue: 'Bearer ' + pm.collectionVariables.get('tokenProviderA') }",
              "  }",
              "}));"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('mensagem aceita pelo SQS', () => pm.response.to.have.status(200));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "url": "{{sqsUrl}}/",
            "header": [
              { "key": "Content-Type", "value": "application/x-amz-json-1.0" },
              { "key": "X-Amz-Target", "value": "AmazonSQS.SendMessage" }
            ],
            "body": { "mode": "raw", "raw": "{{sqsRequest}}" }
          }
        },
        {
          "name": "Enviar sem token (vai para a DLQ)",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const id = 'sqs-noauth-' + Date.now();",
              "const envelope = JSON.parse(pm.collectionVariables.get('sqsEnvelope'));",
              "envelope.messageId = 'msg-' + id;",
              "envelope.data.externalTransactionId = id;",
              "envelope.data.idempotencyKey = 'provider-a:' + id;",
              "pm.collectionVariables.set('sqsRequest', JSON.stringify({",
              "  QueueUrl: pm.collectionVariables.get('queuePrefix') + '/wager-operations.fifo',",
              "  MessageBody: JSON.stringify(envelope),",
              "  MessageGroupId: pm.collectionVariables.get('walletId'),",
              "  MessageDeduplicationId: id",
              "}));"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('mensagem aceita pelo SQS', () => pm.response.to.have.status(200));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "url": "{{sqsUrl}}/",
            "header": [
              { "key": "Content-Type", "value": "application/x-amz-json-1.0" },
              { "key": "X-Amz-Target", "value": "AmazonSQS.SendMessage" }
            ],
            "body": { "mode": "raw", "raw": "{{sqsRequest}}" }
          }
        },
        {
          "name": "Carteira depois do SQS (debitou 1x)",
          "description": "Aguarde 1 a 2 segundos após os envios. Esperado: saldo 100.00 (110.00 - 10.00) se toda a pasta 3 foi executada.",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "console.log('saldo', pm.response.json().balance);"
          ] } }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallets/{{walletId}}",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenInternal}}" }] }
          }
        },
        {
          "name": "Ler DLQ",
          "description": "Mostra as mensagens recusadas com failureCode e failureReason. Ler torna a mensagem invisível por 30 s; ela não é apagada.",
          "request": {
            "method": "POST",
            "url": "{{sqsUrl}}/",
            "header": [
              { "key": "Content-Type", "value": "application/x-amz-json-1.0" },
              { "key": "X-Amz-Target", "value": "AmazonSQS.ReceiveMessage" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"QueueUrl\": \"{{queuePrefix}}/wager-operations-dlq.fifo\",\n  \"MaxNumberOfMessages\": 10,\n  \"MessageAttributeNames\": [\"All\"]\n}" }
          }
        },
        {
          "name": "Ler eventos publicados",
          "description": "Eventos da outbox (WagerTransactionProcessed, WalletBalanceChanged...). MessageGroupId = carteira. Ler torna as mensagens invisíveis por 30 s.",
          "request": {
            "method": "POST",
            "url": "{{sqsUrl}}/",
            "header": [
              { "key": "Content-Type", "value": "application/x-amz-json-1.0" },
              { "key": "X-Amz-Target", "value": "AmazonSQS.ReceiveMessage" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"QueueUrl\": \"{{queuePrefix}}/wallet-events.fifo\",\n  \"MaxNumberOfMessages\": 10,\n  \"MessageAttributeNames\": [\"All\"],\n  \"MessageSystemAttributeNames\": [\"MessageGroupId\"]\n}" }
          }
        },
        {
          "name": "Esvaziar fila de eventos",
          "request": {
            "method": "POST",
            "url": "{{sqsUrl}}/",
            "header": [
              { "key": "Content-Type", "value": "application/x-amz-json-1.0" },
              { "key": "X-Amz-Target", "value": "AmazonSQS.PurgeQueue" }
            ],
            "body": { "mode": "raw", "raw": "{ \"QueueUrl\": \"{{queuePrefix}}/wallet-events.fifo\" }" }
          }
        }
      ]
    }
  ]
}
