            "body": { "mode": "raw", "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{betId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-987\",\n  \"gameId\": \"fortune-chimp\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" }\n}" }
