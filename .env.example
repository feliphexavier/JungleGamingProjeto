# Valores locais de exemplo para desenvolvimento. Nenhum segredo real.

# PostgreSQL do Docker Compose (porta 5433 no host)
DATABASE_URL=postgres://apostas:apostas@localhost:5433/apostas?sslmode=disable

# HTTP
HTTP_PORT=8080

# Validação de tokens (Keycloak do Docker Compose)
OIDC_ISSUER=http://localhost:8081/realms/wallet
OIDC_JWKS_URL=http://localhost:8081/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api

# SQS (LocalStack do Docker Compose). Credenciais fictícias aceitas pelo LocalStack.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_INBOUND_QUEUE=wager-operations.fifo
SQS_DLQ=wager-operations-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
# SQS_WAIT_TIME=10s  SQS_MAX_MESSAGES=10  SQS_PROCESS_TIMEOUT=15s

# Publicação da outbox
# OUTBOX_INTERVAL=500ms  OUTBOX_BATCH=100  OUTBOX_LEASE=30s  OUTBOX_MAX_BACKOFF=5m

# Encerramento e workers
# SHUTDOWN_TIMEOUT=20s  PENDING_REFERENCE_INTERVAL=1s  PENDING_REFERENCE_BATCH=100  LOG_LEVEL=INFO

# Clients de exemplo provisionados em deploy/keycloak/wallet-realm.json
# (client_credentials: client_id / client_secret)
#   provider-a       / provider-a-secret        -> provider_id=provider-a
#   provider-b       / provider-b-secret        -> provider_id=provider-b
#   wallet-internal  / wallet-internal-secret   -> papel wallet-internal
#   untrusted-client / untrusted-client-secret  -> sem permissões

# Testes de integração
TEST_DATABASE_URL=postgres://apostas:apostas@localhost:5433/postgres?sslmode=disable
TEST_KEYCLOAK_URL=http://localhost:8081
TEST_SQS_ENDPOINT=http://localhost:4566
